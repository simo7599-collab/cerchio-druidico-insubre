    <script>
        // Mobile Navigation Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Modal Handlers
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Event Modal Dynamic Loader
        function openEventModal(title, date, location, description) {
            document.getElementById('modal-event-title').innerText = title;
            document.getElementById('modal-event-date').innerHTML = `<i class="fa-regular fa-calendar mr-1"></i> ${date}`;
            document.getElementById('modal-event-loc').innerHTML = `<i class="fa-solid fa-location-dot mr-1"></i> ${location}`;
            document.getElementById('modal-event-desc').innerText = description;
            openModal('modal-evento');
        }

        // Filter Events by Tab
        function filterEvents(category) {
            const cards = document.querySelectorAll('.event-card');
            const tabs = document.querySelectorAll('.event-tab');

            tabs.forEach(t => {
                t.classList.remove('bg-druid-green', 'text-white');
                t.classList.add('text-druid-textMuted');
            });

            const activeTab = document.getElementById(`tab-${category}`);
            if (activeTab) {
                activeTab.classList.add('bg-druid-green', 'text-white');
                activeTab.classList.remove('text-druid-textMuted');
            }

            cards.forEach(card => {
                if (category === 'all' || card.classList.contains(category)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Search Articles
        function filterArticles() {
            const query = document.getElementById('article-search').value.toLowerCase();
            const items = document.querySelectorAll('.article-item');

            items.forEach(item => {
                const title = item.querySelector('.article-title').innerText.toLowerCase();
                const content = item.querySelector('p').innerText.toLowerCase();
                if (title.includes(query) || content.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }


    </script>
